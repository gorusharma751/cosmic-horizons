# ===== BACKEND .env =====
# Copy this file to .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# For local development with Supabase:
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]
# Example: postgresql://postgres:password@localhost:5432/cosmic_horizons
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmic_horizons

# JWT Secret - Change this in production!
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-in-production

# Razorpay (Payment Gateway)
# Get from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# Twilio (SMS/WhatsApp OTP)
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# OpenAI (AI Features - Kundli, Horoscope)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini AI (Social Media Post Generation)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Image/Video Uploads)
# Get from: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis (Caching & Job Queue)
# For local development: redis://localhost:6379
# For production: Get from Redis Cloud or AWS ElastiCache
REDIS_URL=redis://localhost:6379

# Email (Transactional Emails)
# Using Gmail: Enable 2FA and create App Password
# Get from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===== COSMIC HORIZONS BACKEND - ENVIRONMENT VARIABLES =====
# Copy this file to .env and fill in your actual API keys

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================================
# DATABASE SETUP
# ============================================================
# PostgreSQL Connection String
# Local Development: postgresql://postgres:postgres@localhost:5432/cosmic_horizons
# Supabase: postgresql://[user]:[password]@[project].supabase.co:5432/postgres
# PlanetScale: mysql://[user]:[password]@[host]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmic_horizons

# ============================================================
# AUTHENTICATION
# ============================================================
# JWT Secret (minimum 32 characters for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# ============================================================
# PAYMENT GATEWAY - RAZORPAY
# ============================================================
# Get keys from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# SMS & WhatsApp OTP - TWILIO
# ============================================================
# Get account details from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ============================================================
# AI SERVICES
# ============================================================
# OpenAI (for Kundli, Horoscope, Chat)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini AI (for Social Media Post Auto-Generation)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# MEDIA UPLOADS - CLOUDINARY
# ============================================================
# Get from: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# CACHE & JOB QUEUE - REDIS
# ============================================================
# Local Development: redis://localhost:6379
# Production: Redis Cloud, AWS ElastiCache, or similar
REDIS_URL=redis://localhost:6379

# ============================================================
# TRANSACTIONAL EMAIL - SMTP
# ============================================================
# Using Gmail:
#   1. Enable 2-Factor Authentication
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the app password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Alternative: SendGrid, AWS SES, or other SMTP providers

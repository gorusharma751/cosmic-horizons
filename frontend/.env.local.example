# Frontend environment variables (Vercel / local)

# Local development backend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Public Razorpay key (same as backend RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxx

# Optional app metadata
NEXT_PUBLIC_APP_NAME=Cosmic Horizons
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example values:
# NEXT_PUBLIC_API_URL=https://cosmic-horizons-backend.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://cosmic-horizons-backend.onrender.com
# NEXT_PUBLIC_APP_URL=https://your-frontend-domain.vercel.app
# In production, set NEXT_PUBLIC_API_URL in Vercel. The app no longer falls back to localhost.
